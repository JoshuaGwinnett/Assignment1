<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GearRental">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Second Activity: the booking confirmation workflow, reached via
             Intent + Parcelable from MainActivity, returning its outcome
             through the Activity Result API. Not part of Navigation Compose. -->
        <activity
            android:name=".BookingActivity"
            android:exported="false"
            android:label="@string/booking_activity_title" />
    </application>

</manifest>
